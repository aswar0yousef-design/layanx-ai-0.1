## LayanX AI runtime mode: local | cloud | hybrid
LAYANX_AI_MODE=local

# Ollama
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Leave empty: LayanX picks the best installed model per task. Set only to force one.
OLLAMA_MODEL=
# First load of a model on CPU can be slow; generation timeout in ms
OLLAMA_TIMEOUT_MS=180000

# OpenAI
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/responses
OPENAI_HEALTH_URL=https://api.openai.com/v1/models
OPENAI_MODEL=gpt-5.6-luna
# Voice (OpenAI audio endpoints; optional until an API key is configured)
OPENAI_AUDIO_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Anthropic Claude
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_HEALTH_URL=https://api.anthropic.com/v1/models
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_HEALTH_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.6-flash


# Free LLM directory bootstrap (metadata from the upstream open-source directory)
# Keys are resolved from the encrypted local vault first, then these environment variables.
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
HF_TOKEN=
CEREBRAS_API_KEY=
ZAI_API_KEY=
# GitHub Models uses GITHUB_TOKEN above.

# Optional aggregated free AI capacity pool.
# Keep disabled unless you explicitly configure local gateways such as FreeLLMAPI/OmniRoute.
LAYANX_FREE_POOL_ENABLED=false
LAYANX_FREE_POOL_CONFIG=.layanx/free-providers.json
# Set true to prefer configured free models over paid cloud models when no per-request preference is supplied.
LAYANX_AI_PREFER_FREE=false

# Agent Reach internet research capability layer (optional; external CLI stays outside this repo)
LAYANX_AGENT_REACH_COMMAND=agent-reach

# Local speech-to-text (whisper.cpp server). Found automatically on 127.0.0.1:8178; set only for another address.
LAYANX_STT_BASE_URL=
# per-task  = each job uses its best installed model (default); single = one model for everything (fewer swaps)
LAYANX_OLLAMA_ROUTING=per-task
# "on" lets thinking models (qwen3.5, deepseek-r1...) reason before answering: better plans, much slower on small GPUs
LAYANX_OLLAMA_THINK=
# Override detected NVIDIA VRAM (MB), e.g. for AMD/Intel GPUs
LAYANX_GPU_VRAM_MB=

# Autonomy. Default trust for projects without their own level: supervised | trusted | full
LAYANX_DEFAULT_TRUST=supervised
# Coding agents the supervisor can delegate to (auto-detected): Aider uses this local model
LAYANX_CODER_MODEL=qwen2.5-coder:7b
# Extra flags for the OpenAI Codex CLI. Note: --full-auto lets Codex run the project's own scripts while it
# holds OPENAI_API_KEY; use it only with restricted or Docker isolation on projects you do not fully trust.
LAYANX_CODEX_ARGS=
# Browser testing uses Edge/Chrome; set a browser executable to override
LAYANX_BROWSER_PATH=

# Jarvis assistant (/voice): daily briefing time HH:MM (empty = off) and the project it reports on
LAYANX_BRIEFING_TIME=
LAYANX_BRIEFING_PROJECT=default
# Max tools sent to the planner for non-development goals (small local models choose better with fewer)
LAYANX_PLANNER_TOOL_BUDGET=16

# Local Runtime API
LAYANX_API_HOST=127.0.0.1
LAYANX_API_PORT=3000
# Generated automatically and kept in the encrypted store when you start with LayanX.cmd / npm run local
LAYANX_API_TOKEN=
# Visual Flow Builder / local orchestration
LAYANX_FLOW_HOST=127.0.0.1
LAYANX_FLOW_PORT=3100
# Project used for live WhatsApp/Telegram channel flows when the inbound message has no projectId metadata
LAYANX_CHANNEL_PROJECT_ID=default

# Optional GitHub read connector token (never commit the actual token)
GITHUB_TOKEN=
# Website platforms (Control Center -> Integrations -> Platforms stores these in the secret store; put them
# here only if you do not use the Control Center). Each token goes only to its own platform.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
HOSTINGER_API_TOKEN=
CLOUDFLARE_API_TOKEN=
NETLIFY_PERSONAL_ACCESS_TOKEN=
SUPABASE_ACCESS_TOKEN=
CONTEXT7_API_KEY=

# Business Operations (local secrets only; never commit real values)
LAYANX_BUSINESS_STORAGE_PATH=.layanx/business.json
LAYANX_MEDIA_STORAGE_PATH=.layanx/media.json
# Optional encrypted local credential vault. Keep the master key outside Git and outside .env.example.
LAYANX_SECRET_VAULT_PATH=.layanx/secrets.vault
LAYANX_SECRET_VAULT_KEY=
LAYANX_COMMERCE_TOKEN=
LAYANX_SHOPIFY_ACCESS_TOKEN=
LAYANX_WOOCOMMERCE_CONSUMER_KEY=
LAYANX_WOOCOMMERCE_CONSUMER_SECRET=
LAYANX_SOCIAL_TOKEN=
LAYANX_SOCIAL_PUBLISH_URL=

# Paid advertising (local secrets only; never commit real values)
# Meta / Facebook + Instagram Ads
LAYANX_META_ADS_BASE_URL=
LAYANX_META_ADS_TOKEN=
LAYANX_META_ADS_PATH_PREFIX=
# TikTok Ads
LAYANX_TIKTOK_ADS_BASE_URL=
LAYANX_TIKTOK_ADS_TOKEN=
LAYANX_TIKTOK_ADS_PATH_PREFIX=
# Google Ads REST
LAYANX_GOOGLE_ADS_BASE_URL=https://googleads.googleapis.com
LAYANX_GOOGLE_ADS_TOKEN=
LAYANX_GOOGLE_ADS_PATH_PREFIX=
# X Ads
LAYANX_X_ADS_BASE_URL=
LAYANX_X_ADS_TOKEN=
LAYANX_X_ADS_PATH_PREFIX=

# Optional per-operation paths override the shared PATH_PREFIX (use the official platform API paths).
# Example operation keys: CAMPAIGN_CREATE_PATH, CAMPAIGN_UPDATE_PATH, CAMPAIGN_PAUSE_PATH,
# AD_GROUP_CREATE_PATH, AD_CREATE_PATH, INSIGHTS_PATH.
# LAYANX_META_ADS_CAMPAIGN_CREATE_PATH=
# LAYANX_META_ADS_HEADERS_JSON={"Some-Platform-Header":"value"}
# LAYANX_TIKTOK_ADS_HEADERS_JSON=
# LAYANX_GOOGLE_ADS_HEADERS_JSON={"developer-token":"...","login-customer-id":"..."}
# LAYANX_X_ADS_HEADERS_JSON=
# LAYANX_LINKEDIN_ADS_HEADERS_JSON={"Linkedin-Version":"202601"}
# LAYANX_SNAPCHAT_ADS_HEADERS_JSON=
# LAYANX_PINTEREST_ADS_HEADERS_JSON=
# LAYANX_REDDIT_ADS_HEADERS_JSON=

# Platform-specific organic social publishing endpoints/tokens (keep real secrets local)
LAYANX_INSTAGRAM_SOCIAL_PUBLISH_URL=
LAYANX_INSTAGRAM_SOCIAL_TOKEN=
LAYANX_FACEBOOK_SOCIAL_PUBLISH_URL=
LAYANX_FACEBOOK_SOCIAL_TOKEN=
LAYANX_TIKTOK_SOCIAL_PUBLISH_URL=
LAYANX_TIKTOK_SOCIAL_TOKEN=
LAYANX_YOUTUBE_SOCIAL_PUBLISH_URL=
LAYANX_YOUTUBE_SOCIAL_TOKEN=
LAYANX_X_SOCIAL_PUBLISH_URL=
LAYANX_X_SOCIAL_TOKEN=
LAYANX_LINKEDIN_SOCIAL_PUBLISH_URL=
LAYANX_LINKEDIN_SOCIAL_TOKEN=
LAYANX_SNAPCHAT_SOCIAL_PUBLISH_URL=
LAYANX_SNAPCHAT_SOCIAL_TOKEN=
LAYANX_PINTEREST_SOCIAL_PUBLISH_URL=
LAYANX_PINTEREST_SOCIAL_TOKEN=

# OAuth connection center (provider client IDs may be public; client secrets are read locally into the encrypted vault)
LAYANX_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/v1/oauth/callback
LAYANX_TIKTOK_OAUTH_CLIENT_ID=
LAYANX_TIKTOK_OAUTH_CLIENT_SECRET=
LAYANX_TIKTOK_OAUTH_REDIRECT_URI=
LAYANX_TIKTOK_OAUTH_SCOPES=user.info.basic,video.publish
LAYANX_GOOGLE_OAUTH_CLIENT_ID=
LAYANX_GOOGLE_OAUTH_CLIENT_SECRET=
LAYANX_GOOGLE_OAUTH_REDIRECT_URI=
LAYANX_GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/adwords
LAYANX_LINKEDIN_OAUTH_CLIENT_ID=
LAYANX_LINKEDIN_OAUTH_CLIENT_SECRET=
LAYANX_LINKEDIN_OAUTH_REDIRECT_URI=
LAYANX_LINKEDIN_OAUTH_SCOPES=openid,profile,w_member_social
LAYANX_PINTEREST_OAUTH_CLIENT_ID=
LAYANX_PINTEREST_OAUTH_CLIENT_SECRET=
LAYANX_PINTEREST_OAUTH_REDIRECT_URI=
LAYANX_PINTEREST_OAUTH_SCOPES=boards:read,boards:write,pins:read,pins:write


# Native social adapters (used automatically when no *_SOCIAL_PUBLISH_URL is configured and an OAuth token exists)
LAYANX_INSTAGRAM_SOCIAL_BASE_URL=https://graph.facebook.com
LAYANX_FACEBOOK_SOCIAL_BASE_URL=https://graph.facebook.com
LAYANX_META_GRAPH_VERSION=
LAYANX_TIKTOK_SOCIAL_BASE_URL=https://open.tiktokapis.com
LAYANX_YOUTUBE_PRIVACY_STATUS=private
LAYANX_PINTEREST_SOCIAL_BASE_URL=https://api.pinterest.com/v5
LAYANX_YOUTUBE_OAUTH_CLIENT_ID=
LAYANX_YOUTUBE_OAUTH_CLIENT_SECRET=
LAYANX_YOUTUBE_OAUTH_REDIRECT_URI=
LAYANX_YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.upload
LAYANX_LINKEDIN_VERSION=202601
LAYANX_LINKEDIN_SOCIAL_POST_URL=https://api.linkedin.com/rest/posts

# Native media inspection limits / persistence
# Inspection uses HEAD requests; media itself remains hosted at its source URL.

# Creator Engine (local-first, optional)
LAYANX_CREATOR_OUTPUT_DIR=.layanx/creator
LAYANX_FFMPEG_PATH=ffmpeg
# Executable that creates one image from a prompt. Args are a JSON string array; placeholders: {prompt} {output} {duration} {aspect}
LAYANX_CREATOR_VISUAL_EXECUTABLE=
LAYANX_CREATOR_VISUAL_ARGS_JSON=["{prompt}","{output}"]
# Optional local TTS executable. Placeholders: {text} {output} {audio}
LAYANX_TTS_EXECUTABLE=
LAYANX_TTS_ARGS_JSON=["{text}","{output}"]
# Optional local ComfyUI (fits a 6 GB GPU with SD 1.5): URL + API-format workflow JSON with {prompt} {output} {aspect}
LAYANX_COMFYUI_URL=
LAYANX_COMFYUI_WORKFLOW_JSON=
# Optional cloud images (PAID per image, billed to OPENAI_API_KEY). Used only when no executable/ComfyUI is set.
# LAYANX_CREATOR_IMAGE_PROVIDER=openai
# LAYANX_CREATOR_IMAGE_MODEL=gpt-image-1
# LAYANX_CREATOR_IMAGE_QUALITY=low   # low | medium | high | auto

# Google Workspace & Merchant Center (OAuth secrets stay local; never commit real values)
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google invoice automation registry (local idempotency only)
LAYANX_GOOGLE_INVOICE_REGISTRY=.layanx/google-invoices.json

# Yahoo Mail (local App Password; never commit real values)
YAHOO_EMAIL=
YAHOO_APP_PASSWORD=

# Quran Publisher
QF_ENV=prelive
QF_CLIENT_ID=
QF_CLIENT_SECRET=
LAYANX_QURAN_RECITATION_ID=
LAYANX_QURAN_RECITER_NAME=
LAYANX_QURAN_LICENSE_APPROVED=false
LAYANX_QURAN_LICENSE_PROOF_URL=
LAYANX_QURAN_RECITER_CREDIT=
LAYANX_QURAN_TRANSLATION_ID=131
LAYANX_QURAN_TRANSLATION_LANGUAGE=en
LAYANX_QURAN_PLATFORMS=youtube,tiktok
LAYANX_QURAN_OUTPUT_DIR=.layanx/quran
LAYANX_QURAN_CHANNEL_NAME=
LAYANX_QURAN_BACKGROUND_PATH=
LAYANX_QURAN_FONT_FILE=
LAYANX_QURAN_FONT_NAME=Amiri
LAYANX_QURAN_AUTOSCHEDULE=false
LAYANX_QURAN_FIRST_HOUR=08
LAYANX_QURAN_FIRST_MINUTE=00
LAYANX_QURAN_SECOND_HOUR=20
LAYANX_QURAN_SECOND_MINUTE=00
LAYANX_QURAN_YOUTUBE_ACCOUNT_ID=
LAYANX_QURAN_YOUTUBE_OAUTH_CONNECTION_ID=
LAYANX_QURAN_TIKTOK_ACCOUNT_ID=
LAYANX_QURAN_TIKTOK_OAUTH_CONNECTION_ID=
LAYANX_QURAN_YOUTUBE_ACCOUNT_NAME=Quran Channel
LAYANX_QURAN_TIKTOK_ACCOUNT_NAME=Quran Channel
LAYANX_TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# ---- v9: models, memory, voice, MCP, security tools (all optional; defaults shown or empty)
# Ollama structured outputs (JSON Schema) for plans: on unless "off"
LAYANX_OLLAMA_STRUCTURED=
# Characters of variable context per prompt (default: from the smallest local num_ctx)
LAYANX_PROMPT_BUDGET_CHARS=
# Runtime storage: auto (SQLite when node:sqlite exists) | sqlite | json
LAYANX_STORAGE=auto
# Semantic memory with an Ollama embedding model (auto-detected from the model plan); "off" to disable
LAYANX_SEMANTIC_MEMORY=
LAYANX_EMBEDDING_MODEL=
# Monthly cloud cap (dollars need prices per 1M tokens) and token cap
LAYANX_CLOUD_MONTHLY_BUDGET_USD=
LAYANX_CLOUD_MONTHLY_TOKENS=
LAYANX_PRICE_ANTHROPIC_IN=
LAYANX_PRICE_ANTHROPIC_OUT=
LAYANX_PRICE_OPENAI_IN=
LAYANX_PRICE_OPENAI_OUT=
LAYANX_PRICE_GEMINI_IN=
LAYANX_PRICE_GEMINI_OUT=
# Local voice (Piper http_server); found automatically on port 8179
LAYANX_TTS_BASE_URL=
LAYANX_TTS_PORT=8179
LAYANX_TTS_VOICE_AR=ar_JO-kareem-medium
LAYANX_TTS_VOICE_EN=en_US-lessac-medium
# Windows desktop helper starts in the background after launch; "off" to disable
LAYANX_DESKTOP_PREWARM=
# Windows desktop island (running mission + waiting approvals on top of every window); "off" to hide it
# (also a switch on the setup page). Phones pair by QR code over TLS; Claude Code / Codex hooks: setup page.
LAYANX_DESKTOP_ISLAND=
# Humanizer for every text written for people (posts, scripts, website/app copy): rewrite (default) = clean +
# check + local-model rewrite that keeps every fact; clean = hidden characters and stock checks only; off.
LAYANX_HUMANIZER=
# MCP registry used by the Integrations page and mcp.registry.search
LAYANX_MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io
# User-level skills folder (SKILL.md format)
LAYANX_SKILLS_DIR=
# Pinned security scanners (install-security-tools.ps1); "off" skips them
LAYANX_TOOLS_DIR=
LAYANX_EXTERNAL_SCANNERS=
LAYANX_OPENGREP_CONFIG=
# Coding agents inside Docker isolation: pinned images whose entry point is the agent CLI
LAYANX_AGENT_IMAGE_AIDER=
LAYANX_AGENT_IMAGE_CLAUDE_CODE=
LAYANX_AGENT_IMAGE_CODEX=

# ---- v10: restricted isolation, web scan, evals, editors (ACP), voice sense, Cohere Arabic ASR
# Restricted isolation (Windows) uses the same memory limit as Docker: LAYANX_DOCKER_MEMORY (default 4g)
# Real OWASP ZAP baseline in Docker: auto (only if the image is downloaded) | on (download once) | off
LAYANX_ZAP=auto
LAYANX_ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:2.17.0
# Speech detection and end-of-turn detection (install-voice-sense.ps1); found automatically on port 8180
LAYANX_VOICE_SENSE_URL=
LAYANX_VOICE_SENSE_PORT=8180
# Local speech-to-text: auto (Cohere if running, else Whisper) | cohere | whisper
LAYANX_STT_ENGINE=auto
LAYANX_COHERE_PORT=8181
LAYANX_COHERE_DEVICE=
# Backup speech-to-text server used when the first one fails (set automatically to Whisper next to Cohere)
LAYANX_STT_FALLBACK_URL=
# Open the finished site of an autonomous job in the browser on this PC (off = never)
LAYANX_OPEN_BROWSER=
# Free public API catalog for projects that need outside data (public-apis, pinned + SHA-256): off = disabled
LAYANX_API_CATALOG=
# ACP agent for Zed / JetBrains (npm run acp): defaults to this PC's LayanX and its local token
LAYANX_URL=
# Cap for JSON answers from Ollama (plans, tool choices); stops runaway output of small models
LAYANX_OLLAMA_NUM_PREDICT=1024
# npm run eval: where reports are written (default .layanx/evals)
LAYANX_EVAL_DIR=

# --- MetaTrader 5 (docs/MT5-LIVE-TRADING.md, docs/MT5-STRATEGY-TESTER.md)
# Real orders need both switches; the account must be demo unless MT5_ALLOW_REAL_ACCOUNT=true.
MT5_LIVE_TRADING_ENABLED=false
MT5_AUTO_SCALPING_ENABLED=false
MT5_ALLOW_REAL_ACCOUNT=false
MT5_MAX_DAILY_LOSS_PERCENT=2
MT5_MAX_TRADES_PER_DAY=20
MT5_MAX_CONSECUTIVE_LOSSES=3
# A separate portable MetaTrader 5 used only for backtests (never the trading terminal).
MT5_TESTER_TERMINAL=
MT5_TESTER_TIMEOUT_MINUTES=30
