{
  "name": "layanx-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "test": "node scripts/test-suite-runner.mjs",
    "security:check": "node scripts/security-check.mjs",
    "release:check": "npm run security:check && npm run typecheck && npm test",
    "ci": "npm run release:check",
    "test:unit": "node scripts/test-suite-runner.mjs",
    "build": "tsc",
    "start": "node dist/health.js",
    "layanx": "tsx src/cli.ts",
    "eval": "tsx scripts/eval.ts",
    "acp": "tsx src/acp/main.ts",
    "smoke:ollama": "tsx scripts/ollama-smoke.ts",
    "doctor": "tsx src/cli.ts doctor",
    "api": "tsx src/api.ts",
    "local": "tsx src/start-local.ts",
    "secrets": "tsx src/secrets-cli.ts",
    "production:preflight": "tsx scripts/production-preflight.ts",
    "production:acceptance": "tsx scripts/production-acceptance.ts",
    "e2e:ollama": "tsx scripts/ollama-e2e.ts",
    "ready": "tsx src/cli.ts ready",
    "operational:acceptance": "tsx scripts/operational-acceptance.ts",
    "operational:acceptance:strict": "tsx scripts/operational-acceptance.ts --strict",
    "trading:evaluate": "tsx scripts/xauusd-evaluation.ts",
    "free:bootstrap": "node scripts/free-llm-bootstrap.mjs",
    "free:check": "npm run typecheck && npm test && npm run build && npm run free:bootstrap",
    "vsix": "node scripts/build-vsix.mjs",
    "tools:security": "tsx scripts/install-security-tools.ts",
    "skills": "tsx src/cli.ts skills",
    "test:integration": "node scripts/test-suite-runner.mjs --suite integration",
    "test:e2e": "node scripts/test-suite-runner.mjs --suite e2e",
    "test:security": "node scripts/test-suite-runner.mjs --suite security",
    "test:recovery": "node scripts/test-suite-runner.mjs --suite recovery"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "@types/pg": "^8.15.5"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "imapflow": "^2.2.1",
    "nodemailer": "^10.2.1"
  },
  "optionalDependencies": {
    "playwright-core": "^1.55.0"
  }
}
